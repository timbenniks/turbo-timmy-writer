{
  "name": "turbo-timmy-writer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:record-auth": "node tests/e2e/record-auth.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:test-migrations": "tsx scripts/test-migrations.ts",
    "db:import-archive": "tsx --env-file=.env.local scripts/import-archive.ts",
    "db:sync-archive-memory": "tsx --env-file=.env.local scripts/sync-archive-memory.ts",
    "db:import-writing": "node --env-file=.env.local scripts/import-writing.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tiptap/core": "3.30.6",
    "@tiptap/extension-image": "3.30.6",
    "@tiptap/pm": "3.30.6",
    "@tiptap/react": "3.30.6",
    "@tiptap/starter-kit": "3.30.6",
    "ai": "^7.0.85",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.14",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
